# Copy this to .env and fill in values. Never commit .env.

# MongoDB (dev)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=transcelerate

# MongoDB (test) — used by pytest via docker compose --profile test
MONGO_TEST_URL=mongodb://localhost:27018
MONGO_TEST_DB_NAME=transcelerate_test

# CDISC Library API — CONFIRMED ACTIVE 2026-04-30 (pschmi11@jh.edu)
# Primary key from api.developer.library.cdisc.org → Account and API Key → Primary key
# Use primary key; secondary is rotation backup
CDISC_API_KEY=your_primary_key_here
CDISC_BASE_URL=https://library.cdisc.org/api

# REDCap sandbox — required for Gate 3 adapter work
# STATUS: pending JHU ICTR response (redcap@jhu.edu)
REDCAP_URL=https://your-redcap-instance.org
REDCAP_API_TOKEN=your_token_here
REDCAP_PROJECT_ID=your_project_id

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
